{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.omkar.vividmomentum",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "dataLocation": "app",
  "storageLocation": "app",
  "enableServer": true,
  "enableNativeAPI": true,
  "serverHeaders": {
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Embedder-Policy": "require-corp"
  },
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "debug.log",
    "window.*",
    "filesystem.*",
    "updater.*"
  ],
  "globalVariables": {
    "TEST1": "Hello",
    "TEST2": [
      2,
      4,
      5
    ],
    "TEST3": {
      "value1": 10,
      "value2": {}
    },
    "ENVMODE": "dev"
  },
  "modes": {
    "window": {
      "title": "Vivid Momentum",
      "width": 800,
      "height": 600,
      "minWidth": 400,
      "minHeight": 300,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": true,
      "icon": "/resources/icons/appIcon.ico",
      "enableInspector": true,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false,
      "useSavedState": false,
      "useLogicalPixels": true
    },
    "browser": {
      "globalVariables": {
        "TEST": "Test value browser"
      },
      "nativeBlockList": [
        "filesystem.*"
      ]
    },
    "cloud": {
      "url": "/resources/#cloud",
      "nativeAllowList": [
        "app.*"
      ]
    },
    "chrome": {
      "width": 800,
      "height": 500,
      "args": "--user-agent=\"Neutralinojs chrome mode\"",
      "nativeBlockList": [
        "filesystem.*",
        "os.*"
      ]
    }
  },
  "cli": {
    "binaryName": "vivid-momentum",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.7.0",
    "clientVersion": "6.7.0"
  },
  "buildScript": {
    "win": {
      "architecture": [
        "x64"
      ],
      "appName": "Vivid Momentum",
      "appIcon": "resources/icons/appicon.ico",
      "copyright": "Omkar Iyer, 2026, Neutralinojs and contributors",
      "fileDescription": "A local Project Tracker app for Desktop",
      "legalCopyright": "Omkar"
    }
  }
}